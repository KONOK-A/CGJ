{
  "$schema": "https://app.kilo.ai/config.json",

  // ==========================================================
  // Unity project-level Kilo configuration
  //
  // This file intentionally does NOT define:
  // - model / provider
  // - API keys
  // - embedding provider
  // - indexing enabled/disabled
  //
  // Those can stay in your global Kilo configuration.
  // This project config focuses on Unity-safe permissions,
  // file watching, and codebase indexing file types.
  // ==========================================================

  "permission": {
    // --------------------------------------------------------
    // Reading
    // --------------------------------------------------------
    // Kilo may read normal project files, including:
    // Assets/, Packages/, ProjectSettings/,
    // Library/PackageCache/, .meta, .asmdef, .csproj, etc.
    //
    // Secrets remain blocked.
    "read": {
      "*": "allow",

      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.jks": "deny",
      "**/*.keystore": "deny",
      "**/*.mobileprovision": "deny"
    },

    // --------------------------------------------------------
    // Editing
    // --------------------------------------------------------
    // Normal source code may be edited automatically.
    // Generated files/caches are blocked.
    // Unity serialized/project-level files require approval.
    "edit": {
      "*": "allow",

      // Secrets / credentials
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.jks": "deny",
      "**/*.keystore": "deny",
      "**/*.mobileprovision": "deny",

      // Unity generated/cache content
      "Library/**": "deny",
      "Temp/**": "deny",
      "Logs/**": "deny",
      "obj/**": "deny",
      "Build/**": "deny",
      "Builds/**": "deny",
      "UserSettings/**": "deny",

      // IDE / generated project files
      ".vs/**": "deny",
      ".idea/**": "deny",
      "**/*.sln": "deny",
      "**/*.slnx": "deny",
      "**/*.csproj": "deny",
      "**/*.suo": "deny",
      "**/*.user": "deny",
      "**/*.userprefs": "deny",

      // Unity Package Manager lock file is generated by Unity
      "Packages/packages-lock.json": "deny",

      // Changes here can affect the entire Unity project.
      // Ask before editing rather than blocking completely.
      "Packages/manifest.json": "ask",
      "ProjectSettings/**": "ask",

      // Unity serialized assets / GUID metadata:
      // readable and searchable, but ask before direct edits.
      "**/*.meta": "ask",
      "**/*.unity": "ask",
      "**/*.prefab": "ask",
      "**/*.asset": "ask",
      "**/*.mat": "ask",
      "**/*.anim": "ask",
      "**/*.controller": "ask",
      "**/*.overrideController": "ask",
      "**/*.playable": "ask",
      // 6.4：手工维护的两个 SDK 项目，不是 Unity 生成工程
      "Tools/YLFramework.Analyzers/Analyzer/YLFramework.Analyzers.csproj": "allow",
      "Tools/YLFramework.Analyzers/Tests/YLFramework.Analyzers.Tests.csproj": "allow",
      // G0：独立临时验证程序，仅放行这三个输入文件
      "Temp/YLAnalyzerG0/global.json": "allow",
      "Temp/YLAnalyzerG0/G0.csproj": "allow",
      "Temp/YLAnalyzerG0/Program.cs": "allow"
    },

    // --------------------------------------------------------
    // Shell commands
    // --------------------------------------------------------
    // Read-only inspection commands can run automatically.
    // Everything else asks first.
    "bash": {
      "*": "ask",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git grep*": "allow",
      "git ls-files*": "allow",

      "dotnet --info*": "allow",
      "dotnet --version*": "allow",
      "dotnet --list-sdks*": "allow",
      "dotnet --list-runtimes*": "allow",
      "Test-Path -LiteralPath *": "allow",
      "git ls-remote --heads origin fusion/6-editor integration/xf-yl": "allow",
      "dotnet restore *Tools/YLFramework.Analyzers/Analyzer/YLFramework.Analyzers.csproj*": "allow",
      "dotnet restore *Tools/YLFramework.Analyzers/Tests/YLFramework.Analyzers.Tests.csproj*": "allow",
      "dotnet build *Tools/YLFramework.Analyzers/Analyzer/YLFramework.Analyzers.csproj*": "allow",
      "dotnet build *Tools/YLFramework.Analyzers/Tests/YLFramework.Analyzers.Tests.csproj*": "allow",
      "dotnet test *Tools/YLFramework.Analyzers/Tests/YLFramework.Analyzers.Tests.csproj*": "allow",
      "dotnet restore *Temp/YLAnalyzerG0/G0.csproj*": "allow",
      "dotnet run *Temp/YLAnalyzerG0/G0.csproj*": "allow",
      "pwsh -NoLogo -NoProfile -NonInteractive -File *Tools/YLFramework.Analyzers/build.ps1*": "allow"
    },
    "ai-game-developer_script-execute": "allow",
    "ai-game-developer_assets-refresh": "allow",
    "ai-game-developer_tests-run": "allow",
    "ai-game-developer_editor-application-get-state": "allow",
    "ai-game-developer_editor-application-set-state": "allow",
    "context7_resolve-library-id": "allow",
    "context7_query-docs": "allow"
  },

  // ==========================================================
  // File watcher
  //
  // Skip noisy Unity-generated directories while keeping them
  // directly readable when Kilo explicitly needs diagnostics.
  // ==========================================================
  "watcher": {
    "ignore": [
      "Library/**",
      "Temp/**",
      "Logs/**",
      "obj/**",
      "Build/**",
      "Builds/**",
      "UserSettings/**",
      "MemoryCaptures/**",
      "Recordings/**",
      ".vs/**",
      ".idea/**"
    ]
  },

  // ==========================================================
  // Codebase indexing
  //
  // Only defines the file-type allowlist.
  // Provider/model/vector store/enabled state are intentionally
  // left to your global Kilo settings.
  //
  // Unity serialized YAML (.unity/.prefab/.asset/.meta) is
  // intentionally NOT embedded. Kilo can still read/grep it.
  // ==========================================================
  "indexing": {
    "fileExtensions": [
      ".cs",

      ".asmdef",
      ".asmref",
      ".rsp",

      ".shader",
      ".cginc",
      ".hlsl",
      ".compute",

      ".uss",
      ".uxml",

      ".json",
      ".xml",
      ".yaml",
      ".yml",
      ".toml",
      ".ini",

      ".md",

      ".lua",

      ".ts",
      ".tsx",
      ".js",
      ".jsx",

      ".c",
      ".cc",
      ".cpp",
      ".h",
      ".hpp",
      ".inl",

      ".py",
      ".ps1",
      ".sh",
      ".bat",
      ".gradle",
      ".properties"
    ]
  },
  "snapshot": false
}
