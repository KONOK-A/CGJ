# ====================================================================
#  Unity 项目 Git 忽略规则
#  - Library/Temp/Logs 等为 Unity 本地生成内容，可随时重建，不提交
#  - 受维护资产的 .meta 随资产提交；本机生成及单独授权内容按下列精确规则处理
# ====================================================================

# ---------- Unity 本地生成目录 ----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ---------- 构建产物 ----------
/[Bb]uild/
/[Bb]uilds/
/[Ee]xportedObj/
/[Aa]ssetBundles/
# XFABManager 与 YLFramework 构建后复制到 StreamingAssets 的 Bundle（由构建脚本重新生成）
/Assets/StreamingAssets/MainModule/
/Assets/StreamingAssets/MainModule.meta
/Assets/StreamingAssets/AssetBundles/
/Assets/StreamingAssets/AssetBundles.meta
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.app

# ---------- IDE / 工具生成文件 ----------
.vs/
.idea/
.consulo/
.gradle/
/UIElementsSchema/
*.csproj
*.sln
*.slnx
*.unityproj
*.booproj
*.suo
*.user
*.userprefs
*.pidb
*.pidb.meta
*.opendb
*.VC.db
*.svd
*.tmp
*.orig

# ---------- XFGameFramework 运行时生成的设置（含本地密钥字段，不入库） ----------
/ProjectSettings/XFGameFramework.*.asset

# ---------- 本机 / 工具遗留文件 ----------
/Diagnostics/
.DS_Store
Thumbs.db
Desktop.ini
~UnityDirMonSyncFile~*
*.private
*.private.*

# ---------- 自动生成的编辑器插件目录 ----------
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# ---------- 单独授权的本机编辑器插件 ----------
/Assets/Plugins/Editor Enhancers Bundle/
/Assets/Plugins/Editor Enhancers Bundle.meta

# ---------- 当前程序集生成的 HybridCLR 测试输入 ----------
/Assets/YLFramework/Tests/Integrations/HybridCLR/PlayMode/Resources/YLHybridCLRTests/*
!/Assets/YLFramework/Tests/Integrations/HybridCLR/PlayMode/Resources/YLHybridCLRTests/.gitkeep

# ---------- 本地 AI 工具缓存（项目自身的 .kilo/ 与 AGENTS.md 仍然提交） ----------
.agents/
.claude/
.codex/
.kilocode/
.opencode/
/.kilo/worktrees/
/.kilo/agent-manager.json
/.mcp.json
/.vscode/mcp.json
/opencode.json

# 临时反编译得到的文件
XFGameFrameworkCodeAnalyzer/

# Hand-maintained analyzer SDK projects, not Unity-generated projects.
!/Tools/YLFramework.Analyzers/Analyzer/YLFramework.Analyzers.csproj
!/Tools/YLFramework.Analyzers/Tests/YLFramework.Analyzers.Tests.csproj
